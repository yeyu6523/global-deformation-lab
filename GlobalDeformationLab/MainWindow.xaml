<Window x:Class="GlobalDeformationLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="全局变换实验室" Width="1280" Height="820"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#171A19">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="318" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,20,22,16">
                    <TextBlock Text="GLOBAL DEFORM" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="全局变换实验室" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,3" />
                    <TextBlock x:Name="ModelInfoText" Text="准备加载模型" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,0,16,22">
                        <TextBlock Text="文件" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource CommandButton}" Click="ImportButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="17" Margin="0,-1,6,0" />
                                    <TextBlock Text="导入 OBJ" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource CommandButton}" Click="ExportButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↓" FontSize="16" Margin="0,-1,6,0" />
                                    <TextBlock Text="导出 OBJ" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="变形模式" Style="{StaticResource SectionLabel}" DockPanel.Dock="Left" />
                            <TextBlock x:Name="ModeHintText" Text="锥化" Style="{StaticResource SectionLabel}"
                                       Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <UniformGrid Columns="2" Margin="0,0,-6,14">
                            <RadioButton x:Name="TaperModeButton" Content="锥化" Tag="Taper" IsChecked="True" GroupName="Mode"
                                         Style="{StaticResource ModeButton}" Checked="ModeButton_Checked" />
                            <RadioButton x:Name="TwistModeButton" Content="扭曲" Tag="Twist" GroupName="Mode"
                                         Style="{StaticResource ModeButton}" Checked="ModeButton_Checked" />
                            <RadioButton x:Name="BendModeButton" Content="弯曲" Tag="Bend" GroupName="Mode"
                                         Style="{StaticResource ModeButton}" Checked="ModeButton_Checked" />
                            <RadioButton x:Name="SqueezeModeButton" Content="挤压" Tag="Squeeze" GroupName="Mode"
                                         Style="{StaticResource ModeButton}" Checked="ModeButton_Checked" />
                            <RadioButton x:Name="FfdModeButton" Content="FFD 晶格" Tag="Ffd" GroupName="Mode"
                                         Style="{StaticResource ModeButton}" Checked="ModeButton_Checked" />
                        </UniformGrid>

                        <StackPanel x:Name="ParamPanel">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="ParameterNameText" Text="锥化强度" FontSize="12" DockPanel.Dock="Left" />
                                <TextBlock x:Name="ParameterValueText" Text="0.55" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <Slider x:Name="ParameterSlider" Minimum="-0.9" Maximum="0.9" Value="0.55"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="ParameterSlider_ValueChanged" Margin="0,0,0,12" />
                            <Button Style="{StaticResource PrimaryButton}" Content="应用当前变形"
                                    Click="ApplyDeformationButton_Click" Margin="0,0,0,20" />
                        </StackPanel>

                        <StackPanel x:Name="FfdPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="晶格密度 n × n × n" FontSize="12" Margin="0,0,0,5" />
                                    <ComboBox x:Name="GridSizeCombo" SelectionChanged="GridSizeCombo_SelectionChanged">
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" IsSelected="True" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="5" />
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource CommandButton}"
                                        Content="重建" Click="RebuildFfdButton_Click" />
                            </Grid>

                            <TextBlock Text="控制点" FontSize="12" Margin="0,0,0,5" />
                            <ComboBox x:Name="ControlPointCombo" SelectionChanged="ControlPointCombo_SelectionChanged"
                                      Margin="0,0,0,10" />

                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <TextBlock Text="X" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="Y" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0" />
                                <TextBlock Text="Z" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0" />
                            </UniformGrid>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <TextBox x:Name="ControlXText" Margin="0,0,5,0" />
                                <TextBox x:Name="ControlYText" Margin="0,0,5,0" />
                                <TextBox x:Name="ControlZText" />
                            </UniformGrid>
                            <Button Style="{StaticResource PrimaryButton}" Content="更新控制点坐标"
                                    Click="UpdateControlPointButton_Click" Margin="0,0,0,8" />
                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <Button Content="X −" Tag="X-" Style="{StaticResource CommandButton}" Margin="0,0,4,4" Click="NudgeControlPoint_Click" />
                                <Button Content="Y −" Tag="Y-" Style="{StaticResource CommandButton}" Margin="0,0,4,4" Click="NudgeControlPoint_Click" />
                                <Button Content="Z −" Tag="Z-" Style="{StaticResource CommandButton}" Margin="0,0,0,4" Click="NudgeControlPoint_Click" />
                                <Button Content="X ＋" Tag="X+" Style="{StaticResource CommandButton}" Margin="0,0,4,0" Click="NudgeControlPoint_Click" />
                                <Button Content="Y ＋" Tag="Y+" Style="{StaticResource CommandButton}" Margin="0,0,4,0" Click="NudgeControlPoint_Click" />
                                <Button Content="Z ＋" Tag="Z+" Style="{StaticResource CommandButton}" Click="NudgeControlPoint_Click" />
                            </UniformGrid>
                        </StackPanel>

                        <TextBlock Text="视图" Style="{StaticResource SectionLabel}" />
                        <CheckBox x:Name="ShowLatticeCheck" Content="显示 FFD 晶格" IsChecked="True"
                                  Checked="ShowLatticeCheck_Changed" Unchecked="ShowLatticeCheck_Changed" Margin="0,0,0,8" />
                        <CheckBox x:Name="OrthographicCheck" Content="正交投影"
                                  Checked="OrthographicCheck_Changed" Unchecked="OrthographicCheck_Changed" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UndoButton" Grid.Column="0" Content="↶" ToolTip="撤销 (Ctrl+Z)"
                                Style="{StaticResource IconButton}" Click="UndoButton_Click" />
                        <Button x:Name="RedoButton" Grid.Column="1" Content="↷" ToolTip="重做 (Ctrl+Y)"
                                Style="{StaticResource IconButton}" Click="RedoButton_Click" Margin="6,0,0,0" />
                        <Button Grid.Column="2" Content="⟳" ToolTip="恢复导入状态"
                                Style="{StaticResource IconButton}" Click="ResetButton_Click" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="3" Text="v1.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#171A19">
            <h:HelixViewport3D x:Name="Viewport" Background="#171A19"
                               ShowViewCube="True" ShowCoordinateSystem="True"
                               IsHeadLightEnabled="False" ZoomExtentsWhenLoaded="True"
                               RotateGesture="LeftClick" PanGesture="MiddleClick"
                               CameraRotationMode="Turntable"
                               RotateAroundMouseDownPoint="True"
                               ZoomAroundMouseDownPoint="True"
                               MouseDown="Viewport_MouseDown"
                               MouseDoubleClick="Viewport_MouseDoubleClick">
                <h:DefaultLights />
                <ModelVisual3D x:Name="MeshVisual" />
            </h:HelixViewport3D>

            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                    Background="#D9141716" BorderBrush="#3CFFFFFF" BorderThickness="1"
                    CornerRadius="4" Padding="11,7" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource WarmBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ViewportStatusText" Text="就绪" Foreground="#F1F4F2" FontSize="12" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                    Background="#D9141716" BorderBrush="#3CFFFFFF" BorderThickness="1"
                    CornerRadius="4" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <Button Content="适配" ToolTip="适配全部模型 (F)" Style="{StaticResource CommandButton}"
                            Height="32" Padding="10,0" Click="FitViewButton_Click" />
                    <Button Content="前" ToolTip="前视图 (1)" Style="{StaticResource CommandButton}"
                            Width="34" Height="32" Padding="0" Margin="5,0,0,0" Tag="Front" Click="PresetViewButton_Click" />
                    <Button Content="顶" ToolTip="顶视图 (2)" Style="{StaticResource CommandButton}"
                            Width="34" Height="32" Padding="0" Margin="5,0,0,0" Tag="Top" Click="PresetViewButton_Click" />
                    <Button Content="右" ToolTip="右视图 (3)" Style="{StaticResource CommandButton}"
                            Width="34" Height="32" Padding="0" Margin="5,0,0,0" Tag="Right" Click="PresetViewButton_Click" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18"
                    Background="#D9141716" CornerRadius="4" Padding="10,6" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="左键旋转  ·  中键平移  ·  滚轮缩放  ·  双击适配"
                               Foreground="#D8DEDB" FontSize="11" />
                    <TextBlock x:Name="ProjectionStatusText" Text="透视视图" Foreground="#849089"
                               FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
